    const trimmed = raw.trim();
    const fenceMatch = trimmed.match(/```(?:tenuto|ten|music|plaintext|[a-zA-Z0-9_-]*)?\s*\n([\s\S]*?)```/i);
    if (fenceMatch && fenceMatch[1]) {
      return fenceMatch[1].trim();
    }
    return trimmed
      .replace(/^```[a-zA-Z0-9_-]*\s*/i, '')
      .replace(/\s*```$/i, '')
      .trim();
  }

