  /**
   * Scans the decoded SoundFont AudioBuffer to find its high-energy active tone plateau
   * (strictly excluding the decaying tail and trailing MP3 silence) and synthesizes a
   * seamless 6.5-second continuous sustain buffer using 50%-overlap Hann-window crossfading.
   */
  private createSustainedOrchestralBuffer(
    ctx: BaseAudioContext,
    srcBuf: AudioBuffer,
    instrumentName: string
  ): AudioBuffer {
    if (!isSustainingOrchestralInstrument(instrumentName) || srcBuf.duration < 0.35) {
      return srcBuf;
    }

    const sr = srcBuf.sampleRate;
    const ch0 = srcBuf.getChannelData(0);
    const srcLen = ch0.length;

    // 1. Scan in 15ms windows to locate the peak RMS sustain plateau
    const winSize = Math.max(256, Math.floor(0.015 * sr));
    const numWins = Math.floor(srcLen / winSize);
    const winRms = new Float32Array(numWins);

    let peakRms = 0;
    let peakWinIdx = 2;
    const startSearchWin = Math.min(numWins - 1, Math.max(1, Math.floor(0.045 / 0.015)));

    for (let w = 0; w < numWins; w++) {
      let sumSq = 0;
      const base = w * winSize;
      for (let i = 0; i < winSize; i++) {
        const s = ch0[base + i] || 0;
        sumSq += s * s;
      }
      const rms = Math.sqrt(sumSq / winSize);
      winRms[w] = rms;
      if (w >= startSearchWin && rms > peakRms) {
        peakRms = rms;
        peakWinIdx = w;
      }
    }

    if (peakRms < 0.0005) {
      return srcBuf;
    }

    // 2. Expand outward from peakWinIdx while window RMS remains >= 52% of peakRms
    // This strictly excludes the decaying tail and trailing silence of the MP3!
    let startWin = peakWinIdx;
    while (startWin > startSearchWin && winRms[startWin - 1] >= peakRms * 0.55) {
      startWin--;
    }

    let endWin = peakWinIdx;
    while (endWin < numWins - 2 && winRms[endWin + 1] >= peakRms * 0.52) {
      endWin++;
    }

    let coreStartIdx = Math.max(Math.floor(0.06 * sr), startWin * winSize);
    let coreEndIdx = Math.min(srcLen - 256, (endWin + 1) * winSize);

    // Ensure at least 180ms of active core span
    if (coreEndIdx - coreStartIdx < Math.floor(0.18 * sr)) {
      coreStartIdx = Math.min(Math.floor(0.08 * sr), Math.floor(srcLen * 0.15));
      coreEndIdx = Math.min(srcLen - 256, coreStartIdx + Math.floor(0.32 * sr));
    }

    const coreSpan = Math.max(1024, coreEndIdx - coreStartIdx);
    const targetDuration = 6.5;
    const targetLen = Math.floor(sr * targetDuration);
    const numCh = srcBuf.numberOfChannels;
    const outBuf = ctx.createBuffer(numCh, targetLen, sr);

    const halfGrain = Math.floor(coreSpan / 2);
    const grainLen = halfGrain * 2;

    for (let ch = 0; ch < numCh; ch++) {
      const inData = srcBuf.getChannelData(ch);
      const outData = outBuf.getChannelData(ch);

      // Copy the natural attack and initial sustain up to coreStartIdx + halfGrain
      const initialEnd = Math.min(targetLen, coreStartIdx + halfGrain);
      for (let i = 0; i < initialEnd; i++) {
        outData[i] = inData[Math.min(srcLen - 1, i)];
      }

      // Compute a smooth per-sample leveling curve across the core so decaying samples stay at 100% peak energy
      const leveledCore = new Float32Array(grainLen);
      for (let k = 0; k < grainLen; k++) {
        const srcPos = coreStartIdx + k;
        const wIdx = Math.min(numWins - 1, Math.floor(srcPos / winSize));
        const localRms = Math.max(peakRms * 0.35, winRms[wIdx] || peakRms);
        const normGain = Math.min(2.2, (peakRms * 0.92) / localRms);
        leveledCore[k] = (inData[Math.min(srcLen - 1, srcPos)] || 0) * normGain;
      }

      // Fade out the end of the initial copy over halfGrain to crossfade into the first grain
      for (let k = 0; k < halfGrain && coreStartIdx + k < targetLen; k++) {
        const fadeOut = 0.5 * (1 + Math.cos((Math.PI * k) / halfGrain));
        outData[coreStartIdx + k] = inData[Math.min(srcLen - 1, coreStartIdx + k)] * fadeOut;
      }

      // Overlap-add 50%-staggered Hann-windowed grains across the entire 6.5-second buffer
      let hopWritePos = coreStartIdx;
      let hopIndex = 0;
      while (hopWritePos < targetLen) {
        for (let k = 0; k < grainLen; k++) {
          const outIdx = hopWritePos + k;
          if (outIdx >= targetLen) break;
          // Raised-cosine Hann window (sums to exactly 1.0 at 50% overlap!)
          const hann = 0.5 * (1 - Math.cos((2 * Math.PI * k) / grainLen));
          // Alternate forward and slightly shifted read offset to prevent mechanical periodicity
          const readOffset = (k + (hopIndex % 2 === 1 ? Math.floor(grainLen * 0.37) : 0)) % grainLen;
          outData[outIdx] += leveledCore[readOffset] * hann;
        }
        hopWritePos += halfGrain;
        hopIndex++;
      }
    }

    return outBuf;
  }

