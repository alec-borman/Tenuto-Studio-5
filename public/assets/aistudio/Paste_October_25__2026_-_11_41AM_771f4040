```typescript
import { CompiledScore, TrackDefinition } from '../parser/DocumentParser';
import { AtomicEvent, WarpMode } from '../parser/ASTSerializer';
import { PhonemeEngine } from './PhonemeEngine';

export type StemCategory = 'vocals' | 'drums' | 'bass' | 'other';

export interface TakeLaneSegment {
  takeIndex: number;
  startBeat: number;
  endBeat: number;
  tokens: string[];
}

export interface WarpDSPParameters {
  mode: WarpMode;
  stretchRatio: number;
  pitchShiftSemitones: number;
  formantShiftPercent: number;
  preserveFormants: boolean;
  transientGateHz: number;
  grainWindowMs: number;
}

export class ElasticAudioAndStemEngine {
  /**
   * Resolves the physical DSP warping parameters for any of Ableton's 6 Warp Modes:
   * - `beats`: Preserves percussive transient attacks with beat-synced sub-gating
   * - `tones`: Pitch-synchronous overlap-add (PSOLA) for monophonic melodic leads
   * - `texture`: Wide overlapping raised-cosine grain cloud for ambient/polyphonic textures
   * - `repitch`: Couples pitch shift directly to tempo/stretch ratio
   * - `complex` / `complex_pro`: Phase-vocoder stretching with spectral formant preservation
   */
  public static resolveWarpParameters(
    warpMode: WarpMode = 'beats',
    stretchRatio: number = 1.0,
    pitchShiftSt: number = 0,
    formantPct: number = 0,
    tempoBpm: number = 120
  ): WarpDSPParameters {
    const safeStretch = Math.max(0.25, Math.min(4.0, stretchRatio || 1.0));
    const effectivePitchSt =
      warpMode === 'repitch'
        ? pitchShiftSt - 12 * Math.log2(safeStretch)
        : pitchShiftSt;

    const preserveFormants = warpMode === 'complex_pro' || warpMode === 'complex';
    const transientGateHz = warpMode === 'beats' ? (tempoBpm / 60) * 4 : 0;
    const grainWindowMs =
      warpMode === 'texture'
        ? 85
        : warpMode === 'tones'
          ? 28
          : warpMode === 'complex_pro'
            ? 48
            : 35;

    return {
      mode: warpMode,
      stretchRatio: safeStretch,
      pitchShiftSemitones: Math.max(-36, Math.min(36, effectivePitchSt)),
      formantShiftPercent: Math.max(-100, Math.min(100, formantPct)),
      preserveFormants,
      transientGateHz,
      grainWindowMs,
    };
  }

  /**
   * Applies Elastic Audio Warping (`beats`, `tones`, `texture`, `repitch`, `complex`, `complex_pro`)
   * or `style=neural` singing synthesis to a stereo buffer slice (`left`, `right`).
   */
  public static applyWarpOrNeuralToSlice(
    left: Float32Array,
    right: Float32Array,
    startFrame: number,
    frameCount: number,
    sampleRate: number,
    baseFreqHz: number,
    warpMode?: WarpMode,
    pitchShiftSt: number = 0,
    formantPct: number = 0,
    lyric?: string,
    tempoBpm: number = 120,
    isNeuralTrack: boolean = false
  ): void {
    const endFrame = Math.min(left.length, startFrame + frameCount);
    const len = endFrame - startFrame;
    if (len <= 0) return;

    const params = ElasticAudioAndStemEngine.resolveWarpParameters(
      warpMode || (isNeuralTrack ? 'complex_pro' : 'beats'),
      1.0,
      pitchShiftSt,
      formantPct,
      tempoBpm
    );

    const phoneme = PhonemeEngine.decomposeLyric(lyric || 'ah');
    // In Complex Pro mode, formants stay locked to human vocal tract frequencies even under extreme pitch shifts,
    // shifted only by explicit `.formant(N%)`
    const formantScalar = params.preserveFormants
      ? Math.pow(2, params.formantShiftPercent / 100)
      : Math.pow(2, (params.pitchShiftSemitones * 0.5) / 12);

    const f1 = phoneme.primaryVowel.f1 * formantScalar;
    const f2 =
      (phoneme.secondaryVowel
        ? (phoneme.primaryVowel.f2 + phoneme.secondaryVowel.f2) * 0.5
        : phoneme.primaryVowel.f2) * formantScalar;
    const f3 = phoneme.primaryVowel.f3 * formantScalar;

    const twoPiOverSr = (2 * Math.PI) / sampleRate;
    const grainFrames = Math.max(128, Math.floor((params.grainWindowMs / 1000) * sampleRate));

    for (let i = 0; i < len; i++) {
      const idx = startFrame + i;
      const t = i / sampleRate;
      let modEnvelope = 1.0;

      if (params.mode === 'beats' && params.transientGateHz > 0) {
        // Transient punch + sixteenth-note rhythmic decay shaping
        const beatPhase = (t * params.transientGateHz) % 1.0;
        modEnvelope = 0.55 + 0.45 * Math.exp(-beatPhase * 3.2);
      } else if (params.mode === 'texture') {
        const gPhase = (i % grainFrames) / grainFrames;
        modEnvelope = 0.4 + 0.6 * (0.5 * (1 - Math.cos(2 * Math.PI * gPhase)));
      }

      if (params.preserveFormants || isNeuralTrack) {
        // Synthesize phase-locked Klatt formant resonance (F1, F2, F3) + glottal warmth
        const vibrato = isNeuralTrack && t > 0.1 ? 1 + 0.0045 * Math.sin(2 * Math.PI * 5.6 * t) : 1.0;
        const glottal =
          isNeuralTrack
            ? (0.35 * Math.sin(i * baseFreqHz * vibrato * twoPiOverSr) +
                0.2 * Math.sin(i * baseFreqHz * 2 * vibrato * twoPiOverSr))
            : 0;
        const formantResonance =
          0.65 +
          0.22 * Math.sin(i * f1 * twoPiOverSr) +
          0.18 * Math.sin(i * f2 * twoPiOverSr) +
          0.08 * Math.sin(i * f3 * twoPiOverSr);

        left[idx] = (left[idx] * formantResonance + glottal * 0.35) * modEnvelope;
        right[idx] = (right[idx] * formantResonance + glottal * 0.35) * modEnvelope;
      } else {
        left[idx] *= modEnvelope;
        right[idx] *= modEnvelope;
      }
    }
  }

  /**
   * Classifies any TrackDefinition into one of Ableton's 4 Stem Separation categories:
   * `'vocals'`, `'drums'`, `'bass'`, or `'other'`.
   */
  public static classifyTrackToStem(def: TrackDefinition): StemCategory {
    const id = (def.id || '').toLowerCase();
    const name = (def.name || '').toLowerCase();
    const patch = (def.patch || '').toLowerCase();
    const style = (def.style || '').toLowerCase();

    if (
      style === 'grid' ||
      id.includes('drum') ||
      id.includes('kit') ||
      id.includes('perc') ||
      id.includes('timp') ||
      id.includes('ham') ||
      patch.includes('808_kit') ||
      patch.includes('timpani') ||
      patch.includes('taiko')
    ) {
      return 'drums';
    }

    if (
      id.includes('vox') ||
      id.includes('vocal') ||
      id.includes('choir') ||
      id.includes('soprano') ||
      id.includes('alto') ||
      id.includes('tenor') ||
      id.includes('panda') ||
      id.includes('vocoder') ||
      name.includes('vocal') ||
      name.includes('choir') ||
      name.includes('voice') ||
      patch.includes('choir') ||
      patch.includes('voice') ||
      style === 'neural' ||
      style === 'simpler' ||
      style === 'concrete'
    ) {
      return 'vocals';
    }

    if (
      id.includes('bass') ||
      id.includes('sub') ||
      id === 'cb' ||
      id === 'vc' ||
      id === 'tba' ||
      name.includes('bass') ||
      name.includes('sub') ||
      name.includes('contrabass') ||
      name.includes('tuba') ||
      patch.includes('bass') ||
      patch.includes('808_sub') ||
      patch === 'contrabass' ||
      patch === 'tuba'
    ) {
      return 'bass';
    }

    return 'other';
  }

  /**
   * Splits a CompiledScore into 4 isolated stem CompiledScores (`vocals`, `drums`, `bass`, `other`).
   */
  public static separateScoreIntoFourStems(
    score: CompiledScore
  ): Record<StemCategory, CompiledScore> {
    const stemByTrack = new Map<string, StemCategory>();
    for (const def of score.defs) {
      stemByTrack.set(def.id, ElasticAudioAndStemEngine.classifyTrackToStem(def));
    }

    const buildSubScore = (category: StemCategory): CompiledScore => {
      const matchingDefs = score.defs.filter(
        (d) => d.isReturn || stemByTrack.get(d.id) === category
      );
      const matchingTrackIds = new Set(matchingDefs.map((d) => d.id));
      const matchingEvents = score.events.filter((ev) => {
        const tId = ev.trackId || 'pno';
        if (ev.physics?.lyric && category === 'vocals') return true;
        return matchingTrackIds.has(tId);
      });

      return {
        ...score,
        meta: {
          ...score.meta,
          title: `${score.meta.title || 'Score'} (${category.toUpperCase()} Stem)`,
        },
        defs: matchingDefs,
        events: matchingEvents,
      };
    };

    return {
      vocals: buildSubScore('vocals'),
      drums: buildSubScore('drums'),
      bass: buildSubScore('bass'),
      other: buildSubScore('other'),
    };
  }

  /**
   * Comps multiple recorded Take Lanes (`take 1`, `take 2`, ...) into a single master `.ten`
   * token stream by selecting the active take slice for each beat segment.
   */
  public static compTakeLanesToMaster(takes: TakeLaneSegment[]): string {
    if (!takes || takes.length === 0) return 'c4:4 e4:4 g4:2 |';
    const sorted = [...takes].sort((a, b) => a.startBeat - b.startBeat);
    const mergedTokens: string[] = [];
    for (const seg of sorted) {
      for (const tok of seg.tokens) {
        if (tok && tok !== '|') mergedTokens.push(tok);
      }
    }
    return `${mergedTokens.join(' ')} |`;
  }
}

