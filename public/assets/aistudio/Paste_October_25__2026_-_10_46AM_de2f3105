                    title="Remove Device from Chain"
                  >
                    ✕
                  </button>
                </div>

                <div className="grid grid-cols-2 gap-1.5">
                  {Object.entries(mergedParams)
                    .slice(0, 4)
                    .map(([paramKey, paramVal]) => (
                      <div
                        key={paramKey}
                        className="bg-slate-900 border border-slate-800 rounded p-1.5 flex flex-col"
