            </label>
            <select
              id={`device-patch-select-${activeTrack.id}`}
              aria-label={`Patch for ${activeTrack.id}`}
              value={activeTrack.patch || 'salamander_grand'}
              onChange={(e) =>
                onUpdateAST({
                  trackId: activeTrack.id,
                  mutationType: 'PATCH_UPDATE',
                  patchName: e.target.value,
                })
              }
              className="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-emerald-300 outline-none focus:border-blue-500 cursor-pointer mb-3"
            >
              {PATCH_CATALOG.map((grp) => (
                <optgroup key={grp.group} label={grp.group}>
                  {grp.options.map((opt) => (
                    <option key={opt} value={opt}>
