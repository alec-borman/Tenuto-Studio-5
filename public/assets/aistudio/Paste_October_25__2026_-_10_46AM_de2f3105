                      {m.key}
                    </span>
                    <input
                      type="number"
                      aria-label={`Macro ${m.key} for ${activeTrack.id}`}
                      min={0}
                      max={127}
                      value={currentVal}
                      onChange={(e) => {
                        const nextVal = Math.max(
                          0,
                          Math.min(127, parseInt(e.target.value, 10) || 0)
                        );
                        onUpdateAST({
                          trackId: activeTrack.id,
                          mutationType: 'MACRO_UPDATE',
                          macroKey: m.key,
