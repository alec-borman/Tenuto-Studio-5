                          step={0.1}
                          value={paramVal}
                          onChange={(e) => {
                            const raw = e.target.value;
                            const parsed =
                              typeof paramVal === 'number' ? parseFloat(raw) || 0 : raw;
                            const nextParams = { ...mergedParams, [paramKey]: parsed };
                            onUpdateAST({
                              trackId: activeTrack.id,
                              mutationType: 'UPDATE_FX_PARAM',
                              fxType: fxItem.type,
                              fxParams: nextParams,
                            });
                          }}
                          className="w-full bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-[10px] text-center text-cyan-200"
                        />
                      </div>
                    ))}
                </div>
              </div>

              <div className="pt-2 border-t border-slate-800 text-[9px] text-slate-500 truncate">
                .fx({fxItem.type}, @&#123;...&#125;)
              </div>
            </div>
          );
        })}

        {/* Add Audio FX Device Card */}
        <div className="w-52 bg-slate-950/60 border border-dashed border-slate-700 rounded-md p-3 flex flex-col items-center justify-center gap-2 shrink-0">
          <span className="text-[11px] font-semibold text-slate-400 uppercase">
