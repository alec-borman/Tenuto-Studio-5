                    fill="none"
                    stroke="#06B6D4"
                    strokeWidth={2}
                  />
                </svg>

                <div className="grid grid-cols-2 gap-1">
                  {Object.entries(mergedParams)
                    .slice(0, 4)
                    .map(([paramKey, paramVal]) => (
