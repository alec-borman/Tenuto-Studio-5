              const frac = rPos - idx0;
              const s0 = ch0[idx0] + (ch0[idx0 + 1] - ch0[idx0]) * frac;
              const s1 = ch1[idx0] + (ch1[idx0 + 1] - ch1[idx0]) * frac;
