        const w3 = (2 * Math.PI * 5869) / sampleRate;
        const w4 = (2 * Math.PI * 7331) / sampleRate;
        const w5 = (2 * Math.PI * 8923) / sampleRate;
        const w6 = (2 * Math.PI * 10459) / sampleRate;

