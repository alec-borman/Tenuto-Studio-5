PART 3: HOW TO WRITE TENUTO SONGS (.ten COMPLETE COMPOSER GUIDE)
3.1 Document Skeleton
A full Tenuto 6.0 score is wrapped in tenuto "6.0" { ... } and organized into global metadata, optional return/group/groove/locator definitions, instrument definitions (def), and sequential measure N { ... } blocks:
code
Tenuto
tenuto "6.0" {
  %% 1. Global Metadata, Scale Lock & Sidechain
  meta @{
    title: "Song Title",
    tempo: 82,
    time: "4/4",
    key: "F#",
    scale: "minor",
    scale_lock: true,
    sidechain: "drums",
    sidechain_tap: "post_fx"
  }

  %% 2. Return Buses (bus:// Spatial Routing)
  return hall_bus "Concert Hall" .fx(hybrid_reverb, @{decay: 4.5, predelay: 24, mix: 1.0})
  return echo_bus "Stereo Echo"  .fx(echo, @{time: 375, feedback: 0.40, mix: 0.35})

  %% 3. Instrument Definitions (style = synth | standard | grid | simpler)
  def saws  "Anthem Supersaw"  style=synth    patch="supersaw"         vol=102 pan=-0.12 detune=90 cutoff=10800 resonance=1.6 sub=72 air=88 duck=58 width=160 slop=34 sends=@{hall_bus: 0.50} .fx(multiband_dynamics, @{amount: 0.55})
  def reese "Reese Sub Bass"   style=synth    patch="reese_bass"       vol=106 pan=0.00  detune=80 cutoff=480   resonance=2.0 sub=96 duck=65 width=120 slop=28 .fx(roar, @{drive: 0.45, mix: 0.60})
  def lead  "Unison Lead"      style=synth    patch="pluck_lead"       vol=104 pan=0.15  detune=84 cutoff=9800  air=84 sends=@{echo_bus: 0.50, hall_bus: 0.45}
  def fpad  "Tape Flutter Pad" style=synth    patch="flutter_pad"      vol=96  pan=-0.18 detune=78 cutoff=6800  sends=@{hall_bus: 0.65}
  def pno   "Salamander Grand" style=standard patch="salamander_grand" vol=102 pan=-0.15 sends=@{hall_bus: 0.50}
  def vln1  "1st Violins"      style=standard patch="violin"           vol=100 pan=-0.38 sends=@{hall_bus: 0.55}
  def vc    "Cellos Section"   style=standard patch="cello"            vol=100 pan=0.25  sends=@{hall_bus: 0.50}
  def cb    "Contrabasses"     style=standard patch="contrabass"       vol=100 pan=0.40  sends=@{hall_bus: 0.30}
  def hn    "French Horns"     style=standard patch="french_horn"      vol=98  pan=-0.25 sends=@{hall_bus: 0.60}
  def choir "Cathedral Choir"  style=standard patch="choir_aahs"       vol=96  pan=0.00  sends=@{hall_bus: 0.70} .fx(vocoder, @{bands: 20, depth: 1.0, mix: 0.85})
  def timp  "Orchestral Timp"  style=standard patch="timpani"          vol=104 pan=-0.05 sends=@{hall_bus: 0.40}
  def drums "Studio Drum Kit"  style=grid     patch="tenuto_808_kit"   vol=106 pan=0.00  .fx(drum_buss, @{drive: 0.35, boom_amount: 0.50})

  %% 4. Sequential Measures (Strictly 4.0 Quarter-Note Beats Per Voice in 4/4)
  measure 1 {
    saws:  [f#3 c#4 f#4 a4 c#5]:1.mf.open_voice.stack("octaves").detune([0, 90, 30]).filter(600, 9500).glide(200ms) |
    reese: f#1:1.mf.detune(80%, 0.20..0.90).warble(28, 1.8).drive([0.25, 0.75]).glide(180ms) |
    lead:  r:2 c#5:4..mf.zap.detune(82%, 0.20..0.90) f#5:8.mf.legato |
    fpad:  [f#3 a3 c#4 e4]:1.mp.detune(78%, 0.20..0.90).flutter([6, 14]).analog_slop(40%).glide(200ms) |
    pno:   f#2:8.mp.ped c#3:8.mp.ped f#3:8.mp.ped a3:8.mp.ped c#4:8.mp.ped f#4:8.mp.ped a4:8.mp.ped c#5:8.mp.ped |
    vln1:  c#5:2..mp.vib f#5:4.mp.legato |
    vc:    f#2:2..mp.vib a2:4.mp.legato |
    cb:    f#1:1.mp |
    hn:    [f#3 a3 c#4]:1.mp.cresc(50, 95) |
    choir: [f#4 a4 c#5]:1.mp.lyric("Shine") |
    timp:  f#2:4.mp r:4 c#2:2.mp.roll(12) |
    drums: <[ v1: k:4.mf r:4 k:4.mp r:4 | v2: r:2 s:4.mf r:4 | v3: ch:8.p ch:8.p ch:8.p oh:8.mp ch:8.p ch:8.p ch:8.p oh:8.mp ]>
  }
