        releaseSec: 0.28,
        sampleOffsetSec: 0.025,
        sustainRatio: 0.95,
        filterCutoffHz: 3800,
      };
    }

    // 3. Woodwinds (Flute, Piccolo, Oboe, English Horn, Clarinet, Bassoon, Sax)
    if (
